# === MAJBURIY ===
# @BotFather dan olingan bot token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ADMIN — sizning Telegram chat ID raqamingiz (matnlar, joy nomlari, stikerlar, statistika faqat sizda).
# Bilmasangiz: bo'sh qoldiring, serverni ishga tushiring va botga /start yozing — bot ID ni aytadi.
OWNER_CHAT_ID=

# === MYSQL BAZA (majburiy) ===
# cPanel → "MySQL Databases" da yaratiladi (nomlar odatda cpanelnomi_ bilan boshlanadi)
DB_HOST=localhost
DB_NAME=ecobiome_seeyou
DB_USER=ecobiome_seeyou
DB_PASS=

# Ixtiyoriy: bosh sahifa (seeyousoon.uz) kimning sahifasini ko'rsatsin, masalan: javohir
# Bo'sh qoldirsangiz — hamma uchun "havolangizni oling" tanishtiruv sahifasi
ROOT_SLUG=

# Bot ishlash usuli: auto (standart) | polling (kompyuter/VPS) | webhook (cPanel hosting)
BOT_MODE=auto

# === SAYT SOZLAMALARI ===
# Saytda ko'rinadigan ismingiz va qisqa tavsif
OWNER_NAME=Javohir Ozodov
OWNER_TITLE=Qachon va qayerda ko'rishamiz? 🌸

# Saytning ochiq manzili (bot xabarlarida havola sifatida ishlatiladi)
SITE_URL=http://localhost:3000
PORT=3000

# === BO'SH VAQTLARINGIZ ===
TIMEZONE=Asia/Tashkent
# Hafta kunlari: 1=Dushanba ... 6=Shanba, 0=Yakshanba
WORK_DAYS=0,1,2,3,4,5,6
WORK_START=10:00
WORK_END=23:00
# Tushlik tanaffusi (bo'sh qoldirsangiz tanaffus yo'q)
BREAK_START=
BREAK_END=
# Bitta uchrashuv davomiyligi (daqiqa)
SLOT_MINUTES=60
# Necha kun oldinga yozilish mumkin
DAYS_AHEAD=14
# Hozirgi vaqtdan kamida necha daqiqa keyinga yozilish mumkin
MIN_NOTICE_MINUTES=60
# Uchrashuvdan necha daqiqa oldin eslatma yuborilsin (0 = yubormaslik)
REMIND_MINUTES=60
